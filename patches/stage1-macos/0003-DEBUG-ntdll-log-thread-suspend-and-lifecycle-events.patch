+/* Diagnostics for Unity's "SuspendThread loop failed". */
+static LONG gcdiag_fd = -2;  /* -2: undecided, -1: disabled */
+
+static int gcdiag_ms(void)
+{
+    LARGE_INTEGER now;
+    NtQueryPerformanceCounter( &now, NULL );
+    return (int)(now.QuadPart / 10000);
+}
+
+/* Return -2 to retry once the image name is available. */
+static int gcdiag_open(void)
+{
+    const RTL_USER_PROCESS_PARAMETERS *params = NtCurrentTeb()->Peb->ProcessParameters;
+    const char *want = getenv( "WINE_GCDIAG_IMAGE" ), *home = getenv( "HOME" );
+    char path[PATH_MAX], header[256];
+    const WCHAR *image;
+    size_t want_len, len, i;
+    int fd;
+
+    if (!want) want = "Endfield.exe";
+    if (!params || !params->ImagePathName.Buffer) return -2;
+    if (!home) return -1;
+
+    image = params->ImagePathName.Buffer;
+    len = params->ImagePathName.Length / sizeof(WCHAR);
+    want_len = strlen( want );
+    if (len < want_len || (len > want_len && image[len - want_len - 1] != '\\')) return -1;
+    for (i = 0; i < want_len; i++)
+    {
+        WCHAR c = image[len - want_len + i];
+        unsigned char w = want[i];
+        if (c >= 'A' && c <= 'Z') c += 'a' - 'A';
+        if (w >= 'A' && w <= 'Z') w += 'a' - 'A';
+        if (c != w) return -1;
+    }
+
+    snprintf( path, sizeof(path), "%s/Library/Logs/Endfield-gcdiag", home );
+    mkdir( path, 0755 );
+    snprintf( path, sizeof(path), "%s/Library/Logs/Endfield-gcdiag/gcdiag-%ld-%d.log",
+              home, (long)time( NULL ), (int)getpid() );
+    if ((fd = open( path, O_WRONLY | O_CREAT | O_APPEND | O_CLOEXEC, 0644 )) < 0) return -1;
+    len = snprintf( header, sizeof(header), "GCDIAG log pid=%d time=%ld t=%d image=%s\n",
+                    (int)getpid(), (long)time( NULL ), gcdiag_ms(), want );
+    write( fd, header, min( len, sizeof(header) - 1 ));
+    return fd;
+}
+
+static void WINAPIV gcdiag_write( const char *fmt, ... )
+{
+    char buf[512];
+    va_list args;
+    int len, fd = gcdiag_fd;
+
+    if (fd == -2)
+    {
+        int new_fd = gcdiag_open();
+        if (new_fd == -2) return;
+        if ((fd = InterlockedCompareExchange( &gcdiag_fd, new_fd, -2 )) == -2) fd = new_fd;
+        else if (new_fd >= 0) close( new_fd );
+    }
+    if (fd < 0) return;
+
+    va_start( args, fmt );
+    len = vsnprintf( buf, sizeof(buf), fmt, args );
+    va_end( args );
+    if (len > 0) write( fd, buf, min( len, (int)sizeof(buf) - 1 ));
+}
