+/* Log the first 64 events per counter, then powers of two. */
+static void WINAPIV gcdiag_log( LONG *counter, const char *op, HANDLE handle, const char *fmt, ... )
+{
+    LONG n = InterlockedIncrement( counter );
+    char buf[256];
+    va_list args;
+
+    if (n > 64 && (n & (n - 1))) return;
+    va_start( args, fmt );
+    vsnprintf( buf, sizeof(buf), fmt, args );
+    va_end( args );
+    gcdiag_write( "GCDIAG %s #%d t=%d tid=%04x target=%p %s\n", op, (int)n, gcdiag_ms(),
+                  (int)HandleToULong( NtCurrentTeb()->ClientId.UniqueThread ), handle, buf );
+}
