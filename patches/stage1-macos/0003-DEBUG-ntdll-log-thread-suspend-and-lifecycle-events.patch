+static void gcdiag_thread_details( HANDLE handle )
+{
+    OBJECT_BASIC_INFORMATION obj = {0};
+    THREAD_BASIC_INFORMATION tbi = {0};
+    struct { THREAD_NAME_INFORMATION info; WCHAR buf[128]; } tn;
+    char name[129] = "";
+    NTSTATUS obj_status, tbi_status, name_status;
+    int i, len;
+
+    obj_status = NtQueryObject( handle, ObjectBasicInformation, &obj, sizeof(obj), NULL );
+    tbi_status = NtQueryInformationThread( handle, ThreadBasicInformation, &tbi, sizeof(tbi), NULL );
+    name_status = NtQueryInformationThread( handle, ThreadNameInformation, &tn, sizeof(tn), NULL );
+    if (!name_status)
+    {
+        len = min( tn.info.ThreadName.Length / sizeof(WCHAR), sizeof(name) - 1 );
+        for (i = 0; i < len; i++) name[i] = tn.info.ThreadName.Buffer[i] < 0x80 ? tn.info.ThreadName.Buffer[i] : '?';
+        name[len] = 0;
+    }
+    gcdiag_write( "GCDIAG suspend-detail target=%p obj_status=%#x access=%#x handles=%u "
+                  "tbi_status=%#x exit=%#x tid=%04x name_status=%#x name='%s'\n",
+                  handle, (int)obj_status, (int)obj.GrantedAccess, (int)obj.HandleCount,
+                  (int)tbi_status, (int)tbi.ExitStatus, (int)HandleToULong( tbi.ClientId.UniqueThread ),
+                  (int)name_status, name );
+}
