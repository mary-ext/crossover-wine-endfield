+#ifdef __arm64ec__
+static INIT_ONCE int3_once = INIT_ONCE_STATIC_INIT;
+static void *int3_code;
+static BOOL CALLBACK init_int3_code(INIT_ONCE *once, void *param, void **ctx)
+{
+    DWORD old;
+    /* Dynamically allocated executable memory is x64 code in an EC process. */
+    void *code = VirtualAlloc(NULL, 4096, MEM_RESERVE | MEM_COMMIT, PAGE_READWRITE);
+    if (!code) return FALSE;
+    memset(code, 0xcc, 4096);
+    if (!VirtualProtect(code, 4096, PAGE_EXECUTE_READ, &old))
+    { VirtualFree(code, 0, MEM_RELEASE); return FALSE; }
+    FlushInstructionCache(GetCurrentProcess(), code, 4096);
+    int3_code = code;
+    return TRUE;
+}
