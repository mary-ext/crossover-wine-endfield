+
+#ifdef __APPLE__
+/* Never-touched pages of anonymous memory: neither resident nor compressed/swapped. */
+#define MINCORE_UNTOUCHED(vec) (((vec) & (MINCORE_ANONYMOUS | MINCORE_INCORE | MINCORE_PAGED_OUT)) == MINCORE_ANONYMOUS)
+
+static BOOL use_mincore_reads;
+
+/* Check that mincore() reports one entry per host page and identifies untouched pages. */
+static void init_mincore_reads(void)
+{
+    char vec[64];
+    size_t count = ARRAY_SIZE(vec), size = count * host_page_size;
+    char *p;
 
+    if ((p = mmap( NULL, size, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANON, -1, 0 )) == MAP_FAILED) return;
+    memset( vec, 0xff, sizeof(vec) );
+    /* the kernel may materialize several host pages at once, so only check distant pages */
+    p[count / 2 * host_page_size] = 1;
+    if (!mincore( p, size, vec ))
+        use_mincore_reads = MINCORE_UNTOUCHED( vec[0] ) && !MINCORE_UNTOUCHED( vec[count / 2] ) &&
+                            MINCORE_UNTOUCHED( vec[count - 1] );
+    munmap( p, size );
+    TRACE( "untouched page detection %s\n", use_mincore_reads ? "enabled" : "unavailable" );
+}
+#endif
+
