diff --git a/dlls/ntdll/unix/virtual.c b/dlls/ntdll/unix/virtual.c
index c2471ef..9b5d976 100644
--- a/dlls/ntdll/unix/virtual.c
+++ b/dlls/ntdll/unix/virtual.c
@@ -2124,7 +2124,28 @@ static NTSTATUS decommit_pages( struct file_view *view, char *base, size_t size
     else host_end = ROUND_ADDR( base + size, host_page_mask );
 
     if (host_start < host_end) anon_mmap_fixed( host_start, host_end - host_start, PROT_NONE, 0 );
+    /* recommitted pages must read as zeroes; clear the ones sharing a host page with committed memory */
+    if (host_page_mask != page_mask)
+    {
+        char *end = base + size;
+        char *head_end = (host_start < host_end) ? host_start : end;
+        char *tail_start = (host_start < host_end) ? host_end : end;
+
+        if (base < head_end)
+        {
+            char *page = ROUND_ADDR( base, host_page_mask );
+            if (!mprotect( page, ROUND_SIZE( base, head_end - base, host_page_mask ), PROT_READ | PROT_WRITE ))
+                memset( base, 0, head_end - base );
+        }
+        if (tail_start < end)
+        {
+            if (!mprotect( tail_start, ROUND_SIZE( tail_start, end - tail_start, host_page_mask ), PROT_READ | PROT_WRITE ))
+                memset( tail_start, 0, end - tail_start );
+        }
+    }
     set_page_vprot_bits( base, size, 0, VPROT_COMMITTED );
+    /* the pages touched above go back to what the remaining committed pages ask for */
+    if (host_page_mask != page_mask) mprotect_range( base, size, 0, 0 );
     if (host_start < host_end) kernel_writewatch_register_range( view, host_start, host_end - host_start );
     return STATUS_SUCCESS;
 }
