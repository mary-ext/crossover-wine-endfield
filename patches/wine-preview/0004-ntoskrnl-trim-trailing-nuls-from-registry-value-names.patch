diff --git a/dlls/ntoskrnl.exe/ntoskrnl.c b/dlls/ntoskrnl.exe/ntoskrnl.c
index d6979d0..4d0eb7f 100644
--- a/dlls/ntoskrnl.exe/ntoskrnl.c
+++ b/dlls/ntoskrnl.exe/ntoskrnl.c
@@ -5106,3 +5106,39 @@ BOOL WINAPI DllMain( HINSTANCE inst, DWORD reason, LPVOID reserved )
     }
     return TRUE;
 }
+
+/* Kernel callers may count trailing terminators in registry value names. Trim them here rather
+ * than in ntdll, where user-mode names with embedded NULs must stay distinct. */
+static BOOL trim_value_name( const UNICODE_STRING *name, UNICODE_STRING *trimmed )
+{
+    *trimmed = *name;
+    if (trimmed->Length & 1) return FALSE;
+    while (trimmed->Length >= sizeof(WCHAR) && !trimmed->Buffer[trimmed->Length / sizeof(WCHAR) - 1])
+        trimmed->Length -= sizeof(WCHAR);
+    TRACE( "%s -> %s\n", debugstr_us(name), debugstr_us(trimmed) );
+    return TRUE;
+}
+
+NTSTATUS WINAPI ZwQueryValueKey( HANDLE key, const UNICODE_STRING *name,
+                                KEY_VALUE_INFORMATION_CLASS info_class, void *info,
+                                ULONG length, ULONG *result_length )
+{
+    UNICODE_STRING trimmed;
+    if (!trim_value_name( name, &trimmed )) return STATUS_INVALID_PARAMETER;
+    return NtQueryValueKey( key, &trimmed, info_class, info, length, result_length );
+}
+
+NTSTATUS WINAPI ZwSetValueKey( HANDLE key, const UNICODE_STRING *name, ULONG title,
+                              ULONG type, const void *data, ULONG length )
+{
+    UNICODE_STRING trimmed;
+    if (!trim_value_name( name, &trimmed )) return STATUS_INVALID_PARAMETER;
+    return NtSetValueKey( key, &trimmed, title, type, data, length );
+}
+
+NTSTATUS WINAPI ZwDeleteValueKey( HANDLE key, const UNICODE_STRING *name )
+{
+    UNICODE_STRING trimmed;
+    if (!trim_value_name( name, &trimmed )) return STATUS_INVALID_PARAMETER;
+    return NtDeleteValueKey( key, &trimmed );
+}
