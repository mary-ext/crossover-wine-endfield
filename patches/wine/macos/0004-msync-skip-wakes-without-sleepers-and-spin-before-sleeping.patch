+/*
+ * Per-object sleeper counts, allocated by wineserver after the tid map for the session.
+ * Clients skip wake syscalls when the count is zero; wineserver always wakes.
+ *
+ * msync_wait_single() registers before the kernel compares the object state. Releasers
+ * publish state with a full barrier before reading the count: either the releaser sees
+ * the registration or the kernel sees the new state. Overcounts cause only extra wakes.
+ */
+#define WAITER_SLOTS (1u << 22)
+static const mach_vm_size_t shm_waiter_size = WAITER_SLOTS * sizeof(int);
+static int *waiter_table;
+
+/* Spin before untimed object waits to avoid sleeping on short-lived contention.
+ * WINEMSYNC_SPIN_US sets the duration in microseconds; 0 disables spinning. */
+static ULONGLONG spin_ns = 15000;
+
+/* Objects outside the table use unconditional wakes. */
+static inline int *waiter_count( unsigned int idx )
+{
+    return idx < WAITER_SLOTS ? waiter_table + idx : NULL;
+}
