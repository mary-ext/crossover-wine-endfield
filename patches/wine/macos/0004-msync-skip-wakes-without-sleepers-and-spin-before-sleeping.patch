+static BOOL spin_until_changed( void *obj_shm, int val )
+{
+    ULONGLONG deadline = clock_gettime_nsec_np( CLOCK_UPTIME_RAW ) + spin_ns;
+    unsigned int i = 0;
+
+    for (;;)
+    {
+        if (__atomic_load_n( (int *)obj_shm, __ATOMIC_ACQUIRE ) != val) return TRUE;
+        if (!(++i & 15) && clock_gettime_nsec_np( CLOCK_UPTIME_RAW ) >= deadline) return FALSE;
+        YieldProcessor();
+    }
+}
