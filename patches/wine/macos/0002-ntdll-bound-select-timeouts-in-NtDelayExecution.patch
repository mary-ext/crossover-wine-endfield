+/* Darwin rejects select() timeouts over 10^8 seconds with EINVAL.
+ * Attempt one bounded wait; return TRUE if the caller must recompute the remaining time. */
+static BOOL select_max_timeout( timeout_t diff_us, struct timeval *tv )
+{
+    static const time_t max_sec = 86400;
+
+    if (diff_us / 1000000 < max_sec) return FALSE;
+    tv->tv_sec = max_sec;
+    tv->tv_usec = 0;
+    select( 0, NULL, NULL, NULL, tv );
+    return TRUE;
 }
 
 
