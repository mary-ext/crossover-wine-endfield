From a51f06c596cf23f16b79b1ff07e191f2c0de8086 Mon Sep 17 00:00:00 2001
From: Nello De Gregoris <bluechxindv@gmail.com>
Date: Tue, 1 Sep 2026 15:23:18 +0200
Subject: [PATCH] ntoskrnl.exe: Add stub for
 KeRegisterBugCheckReasonCallback().

(cherry picked from commit 7bce51190f378b6312a87232d267cb37aa04a445)
---
 dlls/ntoskrnl.exe/ntoskrnl.c        | 9 +++++++++
 dlls/ntoskrnl.exe/ntoskrnl.exe.spec | 2 +-
 2 files changed, 10 insertions(+), 1 deletion(-)

diff --git a/dlls/ntoskrnl.exe/ntoskrnl.c b/dlls/ntoskrnl.exe/ntoskrnl.c
index 26978df7b74..6afb51b0bc4 100644
--- a/dlls/ntoskrnl.exe/ntoskrnl.c
+++ b/dlls/ntoskrnl.exe/ntoskrnl.c
@@ -2833,6 +2833,15 @@ BOOLEAN WINAPI KeRegisterBugCheckCallback(void *record, void *routine,
     return TRUE;
 }
 
+/***********************************************************************
+ *           KeRegisterBugCheckReasonCallback   (NTOSKRNL.EXE.@)
+ */
+BOOLEAN WINAPI KeRegisterBugCheckReasonCallback(void *record, void *routine, ULONG reason, char *component)
+{
+    FIXME("%p %p %lu %s stub.\n", record, routine, reason, debugstr_a(component));
+    return TRUE;
+}
+
 /***********************************************************************
  *           IoRegisterFileSystem   (NTOSKRNL.EXE.@)
  */
diff --git a/dlls/ntoskrnl.exe/ntoskrnl.exe.spec b/dlls/ntoskrnl.exe/ntoskrnl.exe.spec
index 623d4ddc625..65b990aa276 100644
--- a/dlls/ntoskrnl.exe/ntoskrnl.exe.spec
+++ b/dlls/ntoskrnl.exe/ntoskrnl.exe.spec
@@ -632,7 +632,7 @@
 @ stub KeReadStateSemaphore
 @ stub KeReadStateTimer
 @ stdcall KeRegisterBugCheckCallback(ptr ptr ptr long ptr)
-@ stub KeRegisterBugCheckReasonCallback
+@ stdcall KeRegisterBugCheckReasonCallback(ptr ptr long ptr)
 @ stub KeReleaseInterruptSpinLock
 @ stub KeReleaseMutant
 @ stdcall KeReleaseMutex(ptr long)
